# Google Maps for the National TV Wall's red-zone map (components/tv-wall/google-map.tsx).
# A browser key: it ships to the client, so restrict it by HTTP referrer to the
# site's domains and enable only the "Maps JavaScript API". Leave empty to show
# the plain Google Maps embed without red zones.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# কাণ্ডারী HQ (/hq) — server-only, set in .env.local or the host's secrets.
# Left empty, each falls back to the public test sign-ins in
# lib/hq/server/test-access.ts: fine for a test deploy, set them all before
# the real team signs in.
# The super prime admin's email and password hash (node scripts/hq-hash.mjs).
HQ_PRIME_EMAIL=
HQ_PRIME_PASSWORD_HASH=
# 32+ random characters; signs the session cookies.
HQ_SESSION_SECRET=
# Where the HQ database and uploads live (default .hq-data in the project).
HQ_DATA_DIR=
# Development only: "1" lets screenshot scripts skip the face check with the x-hq-dev-bypass header.
HQ_DEV_FACE_BYPASS=
# Demo sign-ins, one per level below the super prime admin (kandari@demo-chief
# … kandari@demo-intern), all with this password (8+ characters; empty uses the
# built-in test password). The sign-in page shows it to anyone, so set it to
# "off" once the real team signs in; their accounts then go away.
HQ_DEMO_PASSWORD=
