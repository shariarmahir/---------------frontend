/**
 * Writes reference.md: every data source, photograph and film behind the
 * MOTHERLAND category pages, Geography & Travel and Facts about Bangladesh, page by page. The pages
 * themselves show no sources (Mahir, 2026-11-04); this file keeps them.
 *
 * Run: node --experimental-strip-types --no-warnings scripts/motherland-references.mts
 */
import { writeFileSync } from "node:fs";
import { CATEGORIES, categoryCredits } from "../data/motherland-categories.ts";
import { blockCredits, blockSources, type Block, type Src } from "../data/motherland-blocks.ts";
import { DEEP, MORE_FILMS, deepSources } from "../data/motherland-deep.ts";
import { FACT_SOURCES, FACTS_NAME, factsCredits } from "../data/motherland-facts.ts";
import { VIDEOS } from "../data/motherland.ts";
import { CALENDAR_SOURCE } from "../data/motherland-live.ts";
import { PAGE_BLOCKS } from "../data/motherland-pages.ts";
import { TRIP_SOURCES } from "../data/motherland-trip.ts";
import { SOURCES as TRAVEL_SOURCES, travelCredits } from "../data/motherland-travel.ts";

type Credit = { label: string; credit: { author: string; source: string; sourceUrl: string; license: string } };

const escape = (s: string) => s.replace(/\|/g, "\\|");

/** The notes and source columns a page no longer shows, kept here with their sources. */
function shownElsewhere(blocks: Block[]) {
  const out: string[] = [];
  for (const b of blocks) {
    if ((b.kind === "cards" || b.kind === "table" || b.kind === "lines" || b.kind === "map") && b.note) out.push(`- **${b.title}:** ${b.note}`);
    if (b.kind === "table" && b.hideLastColumn) {
      out.push(`- **${b.title}, ${b.head[b.head.length - 1]}:**`);
      for (const r of b.rows) out.push(`  - ${r[0]}: ${r[1]}. ${r[r.length - 1]}`);
    }
  }
  return out;
}

function section(name: string, sources: Src[], credits: Credit[], notes: string[] = []) {
  const lines = [`## ${name}`, ""];
  if (sources.length) {
    lines.push("### Data sources", "");
    for (const s of [...new Map(sources.map((x) => [x.url, x])).values()]) lines.push(`- [${s.name}](${s.url})`);
    lines.push("");
  }
  if (notes.length) lines.push("### Notes and source columns not shown on the page", "", ...notes, "");
  const unique = [...new Map(credits.map((c) => [c.credit.sourceUrl, c])).values()];
  const stills = unique.filter((c) => !/\.(webm|ogv|mp4)$|\/videos?\//i.test(c.credit.sourceUrl));
  const films = unique.filter((c) => /\.(webm|ogv|mp4)$|\/videos?\//i.test(c.credit.sourceUrl));
  if (stills.length) {
    lines.push("### Photographs", "", "| Used for | Author | Site | Licence | Link |", "| --- | --- | --- | --- | --- |");
    for (const c of stills) lines.push(`| ${escape(c.label)} | ${escape(c.credit.author)} | ${c.credit.source} | ${escape(c.credit.license)} | ${c.credit.sourceUrl} |`);
    lines.push("");
  }
  if (films.length) {
    lines.push("### Films", "", "| Used for | Author | Site | Licence | Link |", "| --- | --- | --- | --- | --- |");
    for (const c of films) lines.push(`| ${escape(c.label)} | ${escape(c.credit.author)} | ${c.credit.source} | ${escape(c.credit.license)} | ${c.credit.sourceUrl} |`);
    lines.push("");
  }
  return lines.join("\n");
}

const parts = [
  "# MOTHERLAND references",
  "",
  "Every data source, photograph and film behind the category pages, Geography & Travel and Facts about Bangladesh. The pages show no sources; the footer of each page still lists its photo and film credits, because the CC BY and CC BY-SA licences require them.",
  "",
  "Generated by `scripts/motherland-references.mts` on 2026-11-04. Run it again after changing a page's data.",
  "",
];

for (const c of CATEGORIES.filter((x) => x.slug !== "travel")) {
  const blocks = PAGE_BLOCKS[c.slug] ?? [];
  const film = DEEP[c.slug]?.film;
  const filmCredits = (c.body === "films" ? [...VIDEOS.films, ...MORE_FILMS] : film ? [film] : []).map((f) => ({ label: f.title, credit: f.credit }));
  const extra = c.slug === "culture" ? [CALENDAR_SOURCE] : [];
  parts.push(section(c.name, [...deepSources(c.slug), ...blockSources(blocks), ...extra], [...categoryCredits(c), ...blockCredits(blocks), ...filmCredits] as Credit[], shownElsewhere(blocks)));
}

parts.push(section("Geography & Travel", [...TRAVEL_SOURCES, ...TRIP_SOURCES], travelCredits() as Credit[]));
/* Facts about Bangladesh also names each source on its cards; the list is here so this file stays the whole picture. */
parts.push(section(FACTS_NAME, FACT_SOURCES, factsCredits() as Credit[]));

writeFileSync(new URL("../reference.md", import.meta.url), parts.join("\n"));
console.log("reference.md written");
